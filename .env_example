# .env_example: Sample environment variables for openai-cli
# Copy this file to .env or source it in your shell, and update the values accordingly.

# Primary API key for the selected provider (e.g., OpenAI)
OPENAI_CLI_API_KEY="your-openai-api-key"
# Base URL for API requests (defaults to https://api.openai.com)
OPENAI_CLI_BASE_URL="https://api.openai.com"
# Default provider (openai, anthropic, etc.)
OPENAI_CLI_PROVIDER="openai"
# Log level (debug, info, warn, error)
OPENAI_CLI_LOG_LEVEL="info"

# Password to enable interactive REPL (--prompt-mode)
PROMPT_MODE_PASSWORD="your-prompt-mode-password"

# Agent Backend Configuration
OPENAI_CLI_AGENT_URL="http://localhost:8000"

# Telemetry Configuration (optional)
# Enable telemetry to send usage data and errors to vibes-agent-backend
OPENAI_CLI_TELEMETRY_ENABLED="false"
OPENAI_CLI_TELEMETRY_API_KEY="your-telemetry-api-key"
OPENAI_CLI_TELEMETRY_BATCH_SIZE="50"
OPENAI_CLI_TELEMETRY_FLUSH_INTERVAL="30s"